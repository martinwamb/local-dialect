generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  xpTotal       Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?
  hearts        Int       @default(5)

  accounts      Account[]
  sessions      Session[]
  userLanguages UserLanguage[]
  lessonResults LessonResult[]
  userBadges    UserBadge[]
  xpLogs        XPLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CONTENT ─────────────────────────────────────────────────────────────────

model Language {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nativeName  String
  description String?
  flagEmoji   String?
  isActive    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  units         Unit[]
  userLanguages UserLanguage[]

  @@map("languages")
}

model Unit {
  id          String   @id @default(cuid())
  languageId  String
  title       String
  description String?
  sortOrder   Int
  iconEmoji   String?
  color       String?
  createdAt   DateTime @default(now())

  language Language @relation(fields: [languageId], references: [id])
  lessons  Lesson[]

  @@map("units")
}

model Lesson {
  id          String     @id @default(cuid())
  unitId      String
  title       String
  description String?
  sortOrder   Int
  xpReward    Int        @default(10)
  type        LessonType @default(STANDARD)
  createdAt   DateTime   @default(now())

  unit          Unit           @relation(fields: [unitId], references: [id])
  exercises     Exercise[]
  lessonResults LessonResult[]

  @@map("lessons")
}

enum LessonType {
  STANDARD
  REVIEW
  CHALLENGE
}

model Exercise {
  id        String       @id @default(cuid())
  lessonId  String
  type      ExerciseType
  sortOrder Int
  data      Json
  createdAt DateTime     @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@map("exercises")
}

enum ExerciseType {
  MULTIPLE_CHOICE_TRANSLATE
  MULTIPLE_CHOICE_AUDIO
  TRANSLATE_INPUT
  WORD_ARRANGE
  MATCH_PAIRS
}

// ─── PROGRESS ────────────────────────────────────────────────────────────────

model UserLanguage {
  id               String   @id @default(cuid())
  userId           String
  languageId       String
  enrolledAt       DateTime @default(now())
  xpEarned         Int      @default(0)
  lessonsCompleted Int      @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([userId, languageId])
  @@map("user_languages")
}

model LessonResult {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  completedAt  DateTime @default(now())
  score        Int
  xpEarned     Int
  mistakeCount Int      @default(0)
  durationSec  Int?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@map("lesson_results")
}

model XPLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

// ─── REWARDS ─────────────────────────────────────────────────────────────────

model Badge {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  imageUrl    String
  xpBonus     Int    @default(0)
  criteria    Json

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}
