# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://local_dialect_user:password@localhost:5432/local_dialect"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="https://dialect.wambugumartin.com"

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Email (reminders, unsubscribe links) ──────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Local Dialect <noreply@wambugumartin.com>"
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_SECRET="your-random-secret-here"
# Shared secret the email-reminders cron job sends as x-cron-secret
CRON_SECRET="your-random-secret-here"

# ─── Admin ──────────────────────────────────────────────────────────────────────
# Comma-separated emails allowed to use /api/admin/* routes
ADMIN_EMAILS="martinwamb@gmail.com"

# ─── Audio playback ─────────────────────────────────────────────────────────────
# Optional CDN/base URL prefix for serving generated audio; leave blank to serve
# straight from this app's own public/audio/ directory.
NEXT_PUBLIC_AUDIO_BASE_URL=""

# ─── Ollama (content generation) ────────────────────────────────────────────────
# Ollama endpoint (already running on the Hetzner server, 22:00-06:00 UTC only)
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:14b"
# Ceiling on new items generated per nightly worker run — keeps a single run
# from monopolizing the shared off-peak Ollama window.
STORY_GEN_MAX_TOTAL_PER_RUN="4"
CONTENT_GEN_MAX_TOTAL_PER_RUN="3"

# ─── Dialect pronunciation audio (generate_audio.py / audio-worker.ts) ─────────
# Kikuyu and Luo only — no TTS model exists yet for Kamba or Luhya.
AUDIO_DIR="public/audio"
AUDIO_GEN_MAX_PER_RUN="20"
AUDIO_PYTHON_BIN="python3"
# Local path to the downloaded CLEAR-Global/YourTTS-Luo checkpoint (see the
# module docstring in scripts/generate_audio.py for the download command).
YOURTTS_LUO_DIR="/home/admin/tts-models/yourtts-luo"

# ─── Narrator/instructional voice (lesson intros, quiz feedback) ───────────────
# Path to the edge-tts CLI binary (network-based Microsoft neural TTS, no local
# model/CPU cost — separate from the dialect pronunciation audio above).
EDGE_TTS_BIN="edge-tts"
NARRATION_VOICE="en-US-AriaNeural"

# ─── Media (story images + background audio) ───────────────────────────────────
# Pexels: curated stock photos for story pages. Free tier at pexels.com/api.
PEXELS_API_KEY=""
# Freesound: CC0/Attribution-licensed ambient loops for story background audio.
# Free account at freesound.org/apiv2/apply.
FREESOUND_API_KEY=""
